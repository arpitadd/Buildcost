{
  "name": "buildcost-server",
  "version": "1.0.0",
  "description": "Backend server for BuildCost estimation app",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node db/migrate.js",
    "seed": "node db/seeds/seed_cost_rates.js",
    "seed:contractors": "node db/seeds/seed_contractors.js",
    "seed:all": "node db/seeds/seed_cost_rates.js && node db/seeds/seed_contractors.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.13.0",
    "mongoose": "^8.10.1",
    "pg": "^8.13.1",
    "zod": "^4.4.3"
  }
}
